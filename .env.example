# Kopieren nach .env.local und anpassen. .env.local wird nie committet.

# Lokale Datenbank (docker compose up -d) – in Produktion: Neon-Connection-String (pooled)
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# Öffentliche Basis-URL der App
APP_URL=http://localhost:3000

# Signiert Sessions und verschlüsselt 2FA-Secrets. Erzeugen mit: openssl rand -base64 32
# Ein Wechsel erfordert die Neueinrichtung von 2FA.
BETTER_AUTH_SECRET=

# Nur für Integrationstests: Server, auf dem pro Testlauf eine Wegwerf-DB angelegt wird
TEST_DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/postgres

# Ablage für hochgeladene Medien (lokal). Beim Deployment: Cloudflare R2.
MEDIA_STORAGE_DIR=.data/media

# KI (standardmäßig aus). anthropic = echter Anbieter, fake = Test-Provider (nur Entwicklung).
AI_PROVIDER=none
# Nur bei AI_PROVIDER=anthropic – nie committen, nur in .env.local bzw. als Secret beim Hosting.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Monatliches Limit in USD; danach werden keine KI-Aufträge mehr ausgeführt.
AI_MONTHLY_BUDGET_USD=5
# Preise je Million Tokens (Haiku 5.5, Prompts ≤ 100k, Stand Okt. 2026) – bei Änderungen anpassen.
AI_PRICE_INPUT_USD_PER_MTOK=0.1
AI_PRICE_OUTPUT_USD_PER_MTOK=0.5

# Passphrase für pnpm backup / pnpm restore (mind. 16 Zeichen). Getrennt vom Backup aufbewahren!
BACKUP_PASSPHRASE=

# Medienspeicher: local (Standard, Entwicklung) oder r2 (Betrieb auf Vercel)
MEDIA_STORAGE=local
# Nur bei MEDIA_STORAGE=r2 – Bucket privat lassen, API-Token nur mit Objekt-Lese/Schreibrecht auf diesen Bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
