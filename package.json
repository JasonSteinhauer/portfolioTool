{
  "name": "dev-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test:all",
    "postinstall": "node scripts/copy-fonts.mjs",
    "owner:create": "tsx scripts/create-owner.ts"
  },
  "dependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-bold": "^3.34.0",
    "@tiptap/extension-code": "^3.34.0",
    "@tiptap/extension-document": "^3.34.0",
    "@tiptap/extension-hard-break": "^3.34.0",
    "@tiptap/extension-italic": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-paragraph": "^3.34.0",
    "@tiptap/extension-strike": "^3.34.0",
    "@tiptap/extension-text": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "better-auth": "^1.7.26",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
